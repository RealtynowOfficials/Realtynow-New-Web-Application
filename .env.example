# ----------------------------------------
# MSG91 OTP Authentication — Widget config (frontend-safe; loads the
# MSG91 widget SDK in the browser, see src/lib/msg91.ts). Get these from
# the MSG91 dashboard's OTP Widget config screen for the "Realtynow" widget.
# ----------------------------------------
VITE_MSG91_WIDGET_ID=36676b6c7058303338323331
VITE_MSG91_TOKEN_AUTH=377725TW8g1bjW6a6def54P1

# ----------------------------------------
# MSG91 OTP Authentication — server-side only (Supabase Edge Function
# secrets, set via `supabase secrets set`; never prefix with VITE_)
# ----------------------------------------
MSG91_AUTH_KEY=377725AaDUlgNyLN6a55ddadP1
MSG91_TEMPLATE_ID=63524453d6fc052fb458e833

# ----------------------------------------
# Firebase Cloud Messaging (Web Push) — frontend-safe config (Firebase's
# Web config is not a secret; it's protected by Firebase Security Rules,
# not by being hidden). Get these from Firebase Console → Project Settings
# → General → "Your apps" → Web app. VAPID key is under Project Settings
# → Cloud Messaging → Web configuration → "Web Push certificates".
# src/lib/firebase.ts reads these.
# ----------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=realtynow-8227f.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=realtynow-8227f
VITE_FIREBASE_STORAGE_BUCKET=realtynow-8227f.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=258727218581
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=BFOkfgmGWdaWRn7I0ruadrt0VmIGT4136Ok9jkyIVCaDm-5mC8PnTFoXg_5NM7pb3Jve94O1qIR-1jmnJ8JjnqY

# ----------------------------------------
# Firebase Admin SDK — server-side only (Supabase Edge Function secret,
# set via `supabase secrets set FIREBASE_SERVICE_ACCOUNT_JSON="$(cat key.json)"`;
# never prefix with VITE_, never commit the actual value)
# ----------------------------------------
FIREBASE_SERVICE_ACCOUNT_JSON=
